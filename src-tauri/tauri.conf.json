{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MC Launcher",
  "version": "0.1.0",
  "identifier": "com.qitangsuan.mclauncher.dev",
  "build": {
    "beforeDevCommand": ".\\dev.cmd",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": ".\\build.cmd",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MC Launcher",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
